# Main text/reasoning model. Copy this file to .env, then paste the DeepSeek
# API key after the equals sign. This selected .env is the only accepted source
# for DEEPSEEK_API_KEY. Never commit the populated .env file.
DEEPSEEK_API_KEY=
# DEEPSEEK_PROTOCOL=openai-responses
# DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Tavily is used directly by the built-in WebSearch tool when this key is set.
TAVILY_API_KEY=

# Bocha supplements Tavily and can be selected directly by WebSearch.
bocha_API_KEY=

# OpenRouter Jev Decisions for Computer Use, Rhino, Auto Mode tool approval,
# search reranking, and Workfriend. Jev receives text/structured state only; Qwen
# remains responsible for screenshot vision.
OPENROUTER_API_KEY=
CCAGENT_COMPUTER_USE_JEV=1
# Show a topmost, click-through warning banner and highlighted pointer while
# CCAGENT is actively sending mouse or keyboard input. Enabled by default.
CCAGENT_COMPUTER_USE_INDICATOR=1
# Minimum post-action display time; accepted range is 250-3000 ms.
# CCAGENT_COMPUTER_USE_INDICATOR_HOLD_MS=650
CCAGENT_TOOL_JEV=1
CCAGENT_SEARCH_JEV=1
CCAGENT_WORKFRIEND_JEV=1
CCAGENT_RHINO_JEV=1
# Rhino uses its own mode so it can stay enforcing if Computer Use is shadowed.
CCAGENT_RHINO_JEV_MODE=enforce
# CCAGENT_RHINO_JEV_MIN_CONFIDENCE=0.8
# Default-on bounded Jev fast dispatch inside rhino_agent; 0 disables RhinoSequence.
# Requires Jev enforce. Export/deletion/third-party GH still need separate confirmation.
CCAGENT_RHINO_FAST=1
# Rhino 8 Windows COM automation defaults. Override only for another installed version.
# CCAGENT_RHINO_PROGID=Rhino.Interface.8
# CCAGENT_RHINO_TIMEOUT_MS=60000
# Project outputs default to the current user's Desktop/CCAGENT-Rhino/<unique task>/.
# Optional absolute parent folder; never point this inside the application repository.
# CCAGENT_RHINO_OUTPUT_ROOT=C:\Users\YourName\Desktop\CCAGENT-Rhino
# Optional existing dedicated project folder to continue work across invocations.
# CCAGENT_RHINO_PROJECT_DIR=C:\Users\YourName\Desktop\CCAGENT-Rhino\MyTower
# Auto-clean task-owned intermediate captures after rhino_agent finishes successfully.
# Models, exports, Grasshopper definitions, plans and safety snapshots are retained.
# Set to 0 to retain all captures for debugging; completed bridge temp files still clean up.
CCAGENT_RHINO_AUTO_CLEANUP=1
# Keep the latest 1-20 previews, plus all captures referenced in the final response.
CCAGENT_RHINO_KEEP_CAPTURES=1
# Computer Use: enforce = apply decisions; shadow = log only; off = disabled
CCAGENT_JEV_MODE=enforce
# General Auto Mode tool classifier: enforce, shadow, or off
JEV_TOOL_MODE=enforce
# decision = Jev chooses Workfriend's primary action; advisory = score only; off = disabled
WORKFRIEND_JEV_MODE=decision
JEV_MODEL=~typesafe/jev-latest
# OpenRouter currently exposes Jev through its Decisions endpoint. Override
# only with an official HTTPS openrouter.ai endpoint if the alpha path changes.
# JEV_BASE_URL=https://openrouter.ai/api/alpha/decisions
# JEV_TIMEOUT_MS=5000
# JEV_MIN_CONFIDENCE=0.8

# Optional overrides:
# WEB_SEARCH_ADAPTER=tavily
# WEB_SEARCH_ADAPTER=bocha
# TAVILY_SEARCH_DEPTH=basic
# TAVILY_TIMEOUT_MS=20000
# BOCHA_TIMEOUT_MS=20000

# Optional CNKGraph classical-literature API overrides. classic_words works
# without an API key and restricts custom endpoints to HTTPS cnkgraph.com hosts.
# CLASSIC_WORDS_BASE_URL=https://api.cnkgraph.com
# CLASSIC_WORDS_TIMEOUT_MS=15000

# Optional Bash executable override. On Windows, CCAGENT automatically prefers
# Git Bash over the WSL launcher so native paths such as F:/work remain valid.
# CCAGENT_BASH=C:/Program Files/Git/bin/bash.exe

# Default MCP tools/call timeout. A server-level toolTimeoutMs setting takes
# precedence. Discovery/handshake requests keep their shorter SDK limits.
# MCP_TOOL_TIMEOUT_MS=300000

# Official Google Workspace remote MCP servers (Developer Preview). Run
# `ccagent init` and opt in to install all eight endpoints. Create an OAuth 2.0
# Web client in Google Cloud and register the exact loopback redirect URI.
GOOGLE_MCP_CLIENT_ID=
GOOGLE_MCP_CLIENT_SECRET=

# Agent Teams is enabled by default and is normally managed with /agent-team,
# which writes ~/.ccagent/settings.json. This legacy process override remains:
# CCAGENT_TEAMS=1

# Optional Computer Use perception model. DeepSeek can remain the main text
# model while Qwen interprets screenshots from the selected Windows window.
# QWEN_PROTOCOL=openai-chat
# QWEN_MODEL=qwen3-omni-flash
# DASHSCOPE_BASE_URL=
# DASHSCOPE_API_KEY=
# DASHSCOPE_WORKSPACE_ID=
# QWEN_BASE_URL=
# QWEN_API_KEY=

# Global audio skills. These model IDs are consumed by clone_sound.skill and
# livetranslate.skill; both reuse DASHSCOPE_API_KEY.
QWEN_TTS_MODEL=qwen-audio-3.1-tts-flash
# QWEN_TTS_VOICE=longanhuan_v3.1
# Optional full override for the Qwen-Audio-TTS HTTP endpoint. Normally it is
# derived from DASHSCOPE_BASE_URL (including a workspace-specific base URL).
# DASHSCOPE_TTS_URL=https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/api/v1/services/audio/tts/SpeechSynthesizer
QWEN_LIVETRANSLATE_MODEL=qwen3.8-livetranslate-flash-realtime

# Optional document-conversion runtime overrides. Microsoft Word is preferred
# automatically on Windows; LibreOffice is the cross-platform PDF renderer.
# CCAGENT_OFFICE_ENGINE=word
# CCAGENT_PYTHON=C:/Path/To/python.exe
# CCAGENT_POWERSHELL=C:/Windows/System32/WindowsPowerShell/v1.0/powershell.exe
# CCAGENT_LIBREOFFICE=C:/Program Files/LibreOffice/program/soffice.exe
