{
  "name": "ccagent-cloud",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 4310",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 4310",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:check": "tsx scripts/check-database.ts",
    "db:contract": "tsx scripts/update-migration-contract.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts tests/*.test.tsx",
    "db:rehearse": "tsx scripts/rehearse-recovery.ts",
    "db:backup:local": "tsx scripts/backup-local-windows.ts"
  },
  "dependencies": {
    "@vercel/blob": "2.8.2",
    "better-auth": "1.7.18",
    "dotenv": "17.4.1",
    "drizzle-orm": "0.45.4",
    "next": "16.4.5",
    "postgres": "4.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "resend": "6.37.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "overrides": {
    "esbuild": "0.28.2",
    "@vercel/cli-config": "0.3.7"
  }
}
