{
  "name": "ccdagent",
  "version": "0.1.2",
  "description": "CCAGENT — a terminal-native agentic coding CLI, rebuilt from scratch in TypeScript",
  "type": "module",
  "bin": {
    "ccagent": "dist/ccagent.js"
  },
  "files": [
    "dist",
    ".env.example",
    "README.md",
    "README.zh-CN.md",
    "rhino/ccagent_rhino_runner.py",
    "rhino/ccagent_rhino_architecture.py",
    "rhino/ccagent_rhino_toolkit.py",
    "rhino/ccagent_grasshopper.py",
    "rhino/TOOLKIT.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lvye1989/ccagent.git"
  },
  "homepage": "https://github.com/lvye1989/ccagent#readme",
  "bugs": {
    "url": "https://github.com/lvye1989/ccagent/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "dev": "tsx src/entrypoint/cli.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsup",
    "start": "node dist/ccagent.js",
    "prepare": "npm run build",
    "prepack": "npm run typecheck",
    "prepublishOnly": "npm run verify:release",
    "test:queryengine": "tsx src/scripts/test-queryengine-characterization.ts",
    "test:providerstream": "tsx src/scripts/test-providerstream-characterization.ts",
    "test:notices": "tsx src/scripts/test-useagentsession-notices.ts",
    "test:streaming": "tsx src/scripts/test-streaming.ts",
    "test:tasks": "tsx src/scripts/test-tasks.ts",
    "test:mcp": "tsx src/scripts/test-mcp.ts",
    "test:mcp-controls": "tsx src/scripts/test-mcp-controls.ts",
    "test:skills": "tsx src/scripts/test-skills.ts",
    "test:sandbox": "tsx src/scripts/test-sandbox.ts",
    "test:agents": "tsx src/scripts/test-agents.ts",
    "test:stage20": "tsx src/scripts/test-stage20.ts",
    "test:stage21": "tsx src/scripts/test-stage21.ts",
    "test:stage22": "tsx src/scripts/test-stage22.ts",
    "test:stage23": "tsx src/scripts/test-stage23.ts",
    "test:stage24": "tsx src/scripts/smoke-stage24.tsx",
    "test:stage24-md": "tsx src/scripts/smoke-markdown.tsx",
    "test:stage24-clear": "tsx src/scripts/smoke-static-clear.tsx",
    "test:stage24-ui": "tsx src/scripts/smoke-ui.tsx",
    "test:stage24-ask": "tsx src/scripts/smoke-question.tsx",
    "test:stage24-transcript": "tsx src/scripts/smoke-transcript.tsx",
    "test:stage24-perm": "tsx src/scripts/smoke-permission.tsx",
    "test:stage24-stream": "tsx src/scripts/smoke-bash-stream.ts",
    "test:stage24-input": "tsx src/scripts/smoke-input.tsx",
    "test:stage24-group": "tsx src/scripts/smoke-group.tsx",
    "test:bash-output": "tsx src/scripts/smoke-bash-output.tsx",
    "test:condensed": "tsx src/scripts/smoke-condensed.tsx",
    "test:tool-states": "tsx src/scripts/smoke-tool-states.tsx",
    "test:bash-progress": "tsx src/scripts/smoke-bash-progress.tsx",
    "test:bash-heartbeat": "tsx src/scripts/smoke-bash-heartbeat.tsx",
    "test:live-group": "tsx src/scripts/smoke-live-group.tsx",
    "test:tool-tags": "tsx src/scripts/smoke-tool-tags.tsx",
    "test:transcript-wheel": "tsx src/scripts/smoke-transcript-wheel.tsx",
    "test:stage24-statusline": "tsx src/scripts/smoke-statusline.tsx",
    "test:stage24-command": "tsx src/scripts/smoke-command.tsx",
    "test:stage25": "tsx src/scripts/smoke-config.ts",
    "test:stage30": "tsx scripts/verify-multi-protocol.ts",
    "test:stage31": "tsx src/scripts/test-stage31.ts",
    "test:documents": "tsx src/scripts/test-document-conversion.ts",
    "test:computer-use": "tsx src/scripts/test-computer-use.ts",
    "test:jev-decisions": "tsx src/scripts/test-jev-decisions.ts",
    "test:jev-live": "tsx src/scripts/test-jev-live.ts",
    "test:rhino": "tsx src/scripts/test-rhino-agent.ts && npm run test:rhino-project && npm run test:rhino-fast",
    "test:rhino-fast": "tsx src/scripts/test-rhino-fast.ts",
    "test:rhino-fast-live": "tsx src/scripts/test-rhino-fast-live.ts --execute",
    "test:rhino-project": "tsx src/scripts/test-rhino-project.ts",
    "test:rhino-toolkit": "tsx src/scripts/test-rhino-toolkit.ts",
    "test:rhino-cleanup": "tsx src/scripts/test-rhino-cleanup.ts",
    "test:rhino-cleanup-live": "tsx src/scripts/test-rhino-cleanup-live.ts --execute",
    "test:rhino-live": "powershell -NoProfile -File rhino/test-rhino-toolkit-live.ps1 -Execute",
    "test:init": "tsx src/scripts/test-init.ts",
    "test:workfriend": "tsx src/scripts/test-workfriend.ts",
    "test:agent-team": "tsx src/scripts/test-agent-team.ts",
    "test:agent-skill": "tsx src/scripts/test-agent-skill.ts",
    "test:agent-controls": "tsx src/scripts/test-agent-controls.ts",
    "test:load-env": "tsx src/scripts/test-load-env.ts",
    "test:config-trust": "tsx src/scripts/test-config-trust.ts",
    "test:classic-words": "tsx src/scripts/test-classic-words.ts",
    "test:bash-windows": "tsx src/scripts/test-bash-windows.ts",
    "test:context": "tsx src/scripts/test-context-compaction.ts",
    "test:tools": "tsx src/scripts/test-tools.ts",
    "test:stage32": "tsx src/scripts/test-stage32.ts",
    "test:stage33": "tsx src/scripts/test-stage33.ts",
    "test:stage35": "node --import tsx src/scripts/test-stage35.ts",
    "test:stage35-ui": "tsx src/scripts/test-stage35-ui.tsx",
    "test:stage36": "npm run typecheck && npm run build && node --import tsx src/scripts/test-stage36.ts",
    "verify:release": "npm run test:config-trust && npm run test:load-env && npm run test:init && npm run test:mcp && npm run test:mcp-controls && npm run test:computer-use && npm run test:jev-decisions && npm run test:rhino && npm run test:rhino-toolkit && npm run test:rhino-cleanup && npm run test:workfriend && npm run test:agents && npm run test:agent-team && npm run test:agent-skill && npm run test:agent-controls && npm run test:bash-windows && npm run test:context && npm run test:classic-words && npm run test:stage35 && npm run test:stage36",
    "verify:plugin": "tsx src/scripts/verify-plugin-compat.ts",
    "verify:repository": "tsx scripts/verify-repository-safety.ts",
    "test:filehistory": "tsx src/scripts/smoke-filehistory.ts",
    "test:resilience": "tsx src/scripts/smoke-resilience.ts",
    "smoke:sandbox": "tsx src/scripts/smoke-sandbox.ts",
    "smoke:bash-sandbox": "tsx src/scripts/smoke-bash-sandbox.ts"
  },
  "keywords": [
    "agent",
    "agentic",
    "cli",
    "coding-agent",
    "llm",
    "mcp",
    "terminal"
  ],
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.102.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/diff": "^7.0.2",
    "@types/he": "^1.2.3",
    "@types/node": "^25.5.2",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.2.14",
    "@types/turndown": "^5.0.6",
    "chalk": "^5.6.2",
    "cli-highlight": "^2.1.11",
    "diff": "^9.0.0",
    "dotenv": "^17.4.1",
    "he": "^1.2.0",
    "ignore": "^7.0.5",
    "ink": "^7.0.0",
    "llm-bridge": "^2.0.1",
    "marked": "^18.0.4",
    "proper-lockfile": "^4.1.2",
    "react": "^19.2.4",
    "tsup": "^8.5.0",
    "tsx": "^4.21.0",
    "turndown": "^7.2.4",
    "typescript": "^6.0.3",
    "yaml": "^2.8.3",
    "zod": "^4.4.3"
  }
}
